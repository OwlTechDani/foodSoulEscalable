{
  "name": "food-soul-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST introductoria para Food For My Soul",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/app.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/app.js\"",
    "pretest": "npm run build",
    "test": "node --test",
    "preadmin": "npm run build",
    "admin": "node dist/scripts/make-admin.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "nodemon": "^3.1.7",
    "typescript": "~5.5.4"
  }
}
